{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-chess-lounge.dev/protocol/1.0/move-proposal.schema.json",
  "title": "AI Chess Lounge MoveProposal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "match_id",
    "position_version",
    "move",
    "plan",
    "threat",
    "confidence",
    "usage"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "match_id": { "type": "string", "minLength": 1 },
    "position_version": { "type": "integer", "minimum": 0 },
    "move": { "type": "string", "minLength": 4, "maxLength": 5 },
    "plan": { "type": "string", "maxLength": 280 },
    "threat": { "type": "string", "maxLength": 280 },
    "confidence": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "estimated_cost_usd"
      ],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
