{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-chess-lounge.dev/protocol/1.0/runner-proposal-submission.schema.json",
  "title": "AI Chess Lounge RunnerProposalSubmission 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "proposal", "signature"],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "proposal": { "$ref": "move-proposal.schema.json" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
