{
  "name": "@ai-chess-lounge/runner-sdk",
  "version": "0.1.0",
  "description": "TypeScript runner SDK for AI Chess Lounge remote agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "sample.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "sample": "node sample.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
