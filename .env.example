# Optional when Stockfish is not on PATH. Docker sets this automatically.
STOCKFISH_PATH=/usr/games/stockfish

# Docker Compose sets PostgreSQL automatically. Native development defaults to
# sqlite+aiosqlite:///./.runtime/lounge.db when this is omitted.
# DATABASE_URL=postgresql+asyncpg://lounge:lounge@127.0.0.1:5432/lounge

# Development only. The Vite proxy handles this by default.
# VITE_API_BASE=http://127.0.0.1:8000

# Stage 3B OpenAI adapter. Keep the real value in .env.local for native development.
# OPENAI_API_KEY=
# Optional comma-separated model allowlist shown by the Lounge.
# OPENAI_CHESS_MODELS=gpt-6-astra,gpt-6-sol,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna

# Stage 3C Anthropic adapter. Keep the real value in .env.local for native development.
# ANTHROPIC_API_KEY=
# Optional comma-separated effort-capable model allowlist shown by the Lounge.
# ANTHROPIC_CHESS_MODELS=claude-fable-5-1,claude-opus-5-5,claude-sonnet-5-5

# Stage 3D Google Gemini adapter. Keep the real value in .env.local for native development.
# GEMINI_API_KEY=
# Optional comma-separated model allowlist shown by the Lounge.
# GEMINI_CHESS_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Stage 3E OpenRouter adapter. Keep the real value in .env.local.
# OPENROUTER_API_KEY=
# Optional comma-separated model allowlist. Unknown models remain selectable but use
# provider-default effort until a verified Lounge mapping is added.
# OPENROUTER_CHESS_MODELS=openai/gpt-6.1-sol,openai/gpt-6-astra,anthropic/claude-opus-5.5,anthropic/claude-sonnet-5.5,google/gemini-3.8-flash
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Stage 3E local adapters. Models are opt-in so the catalog never advertises a local
# model that the operator has not installed. No credential is required by default.
# OLLAMA_CHESS_MODELS=llama-chess:latest
# OLLAMA_API_BASE=http://127.0.0.1:11434
# VLLM_CHESS_MODELS=local/chess-model
# VLLM_API_BASE=http://127.0.0.1:8000/v1
# Optional when the vLLM server was launched with --api-key.
# VLLM_API_KEY=

# From the Compose container, use the host alias instead of 127.0.0.1 for a model
# server running directly on the host:
# OLLAMA_API_BASE=http://host.docker.internal:11434
# VLLM_API_BASE=http://host.docker.internal:8000/v1

# Stage 3F provider reliability policy. Retries always remain inside the original
# authoritative move deadline. Defaults are shown; omit them to use these values.
# LOUNGE_PROVIDER_MAX_ATTEMPTS=2
# LOUNGE_PROVIDER_RETRY_BASE_MS=250
# LOUNGE_PROVIDER_RETRY_MAX_MS=2000
# LOUNGE_PROVIDER_REQUESTS_PER_MINUTE=120
# LOUNGE_PROVIDER_OUTAGE_THRESHOLD=3
# LOUNGE_PROVIDER_OUTAGE_COOLDOWN_MS=30000
